TZ=UTC
PORT=8000
# The address you open it at, with the port if it has one
ALLOWED_HOSTS=localhost:8000 127.0.0.1:8000
# login (default), or proxy with TRUSTED_PROXY naming your reverse proxy
AUTH=login
TRUSTED_PROXY=
# Your public https address, for example https://podcasts.example.com
ORIGIN=
# Optional: a hostname for your home address, so feeds can't loop back through your router
HOME_NAMES=
# Host folder holding your media
MEDIA_DIR=./media
